[Unit]
Description=farland multi-session RDP server
Wants=network-online.target
After=network-online.target systemd-logind.service systemd-user-sessions.service

[Service]
Type=exec
ExecStart=@sbindir@/farlandd --config /etc/farland/farland.toml
# The agent socket, /run/farland/agent.sock.
RuntimeDirectory=farland
RuntimeDirectoryMode=0755
# A generated TLS certificate, when farland.toml names none.
StateDirectory=farland
StateDirectoryMode=0700
Restart=on-failure
# Only farlandd itself is signalled. Its sessions outlive it on purpose
# (docs/ROADMAP.md M7): the agent keeps the desktop and reconnects to the
# next farlandd, and the network process goes on relaying its client's
# stream meanwhile, so an upgrade does not disconnect anybody. With
# KillMode=mixed the rest of the cgroup is killed and the client's TLS
# connection dies with it, even though the session itself would have
# survived. Nothing is left behind for good: a network process ends with its
# client or its agent, and an agent that finds no farlandd gives its session
# up after two minutes.
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
